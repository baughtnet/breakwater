# One file per node. ./deploy/setup-node.sh writes this for you; the comments explain each value.

# --- this node -------------------------------------------------------------
BW_NODE_ID=breakwater-1          # a short name, shown on the System page
BW_ROLE=primary                  # primary (holds the settings) or standby
BW_NODE_IP=192.168.0.5           # this machine's own fixed LAN address
BW_TZ=America/Vancouver          # schedules (bedtime, limits) run in this time zone
BW_HTTP_PORT=8080                # dashboard port

# --- your network ----------------------------------------------------------
BW_LAN_CIDR=192.168.0.0/24
BW_ROUTER_IP=192.168.0.1
BW_VIP=192.168.0.2               # the address devices use as gateway and DNS. With one node, use BW_NODE_IP.
BW_DHCP=1                        # 1 = Breakwater hands out addresses (turn the router's DHCP off first!)
BW_DHCP_START=192.168.0.100
BW_DHCP_END=192.168.0.220
BW_DHCP_LEASE=2h

# --- other nodes (leave empty for a single node) ------------------------------
BW_PEERS=                        # e.g. http://192.168.0.6:8080 (comma-separated for several)
BW_PEER_IPS=                     # e.g. 192.168.0.6
BW_VRRP_PRIORITY=150             # highest wins the virtual IP; give the primary the highest

# --- secrets (identical on every node) -----------------------------------------
BW_CLUSTER_TOKEN=change-me       # openssl rand -hex 24
BW_ADGUARD_PASSWORD=change-me    # openssl rand -hex 16
